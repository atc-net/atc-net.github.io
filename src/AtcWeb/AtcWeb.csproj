<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateMvcApplicationPartsAssemblyAttributes>false</GenerateMvcApplicationPartsAssemblyAttributes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="4.0.0" />
    <PackageReference Include="Atc.Blazor" Version="1.0.22" />
    <PackageReference Include="ColorCode.HTML" Version="2.0.15" />
    <PackageReference Include="HtmlSanitizer" Version="10.0.1120" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtcWeb.Domain\AtcWeb.Domain.csproj" />
  </ItemGroup>

  <!--
    Local development: "dotnet run -p:AtcApiBaseAddress=<url>" (used by the Aspire AppHost) bakes the API address
    into the WebAssembly boot config as an environment variable, which overrides wwwroot/appsettings*.json.
  -->
  <ItemGroup Condition="'$(AtcApiBaseAddress)' != ''">
    <WasmEnvironmentVariable Include="AtcApi__BaseAddress" Value="$(AtcApiBaseAddress)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Atc.Analyzer" Version="0.1.23" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>

</Project>