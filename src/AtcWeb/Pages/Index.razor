@page "/"

<PageTitle>ATC-NET - apps and libraries, free and open source</PageTitle>

<MudMainContent>
    @* ===== HERO ===== *@
    <section class="hero-section home-hero">
        <div class="hero-title">ATC-NET</div>
        <div class="hero-subtitle">A Touch of Class</div>
        <div class="hero-description">
            Free, open-source apps for everyone and battle-tested .NET libraries for developers.
            Built from years of real-world experience, MIT licensed.
        </div>

        <div class="home-world-cards">
            <a href="/apps" class="home-world-card home-world-card--apps">
                <img src="/images/atc-apps-logo.png" alt="" width="48" height="48" />
                <span class="home-world-card__text">
                    <b>Apps</b>
                    <span>Apps you can download and use</span>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" aria-hidden="true" />
            </a>
            <a href="/libraries" class="home-world-card home-world-card--libraries">
                <img src="/images/atc-logo.svg" alt="" width="48" height="48" />
                <span class="home-world-card__text">
                    <b>Libraries</b>
                    <span>Libraries and CLI tools for .NET</span>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" aria-hidden="true" />
            </a>
        </div>
        <a href="/introduction/getting-started" class="home-get-started">Get started</a>
    </section>

    <MudContainer MaxWidth="MaxWidth.Large" Class="home-content">

        @* ===== STAT CARDS ===== *@
        <section class="home-stat-cards" aria-label="ATC-NET in numbers">
            <div class="home-stat-card home-stat-card--apps">
                <span class="home-stat-card__value">@Count(appCount)</span>
                <span class="home-stat-card__label">Apps</span>
                <span class="home-stat-card__detail">Download and install</span>
            </div>
            <div class="home-stat-card">
                <span class="home-stat-card__value">@Count(libraryCount)</span>
                <span class="home-stat-card__label">Libraries</span>
                <span class="home-stat-card__detail">NuGet packages</span>
            </div>
            <div class="home-stat-card">
                <span class="home-stat-card__value">@Count(cliToolCount)</span>
                <span class="home-stat-card__label">CLI tools</span>
                <span class="home-stat-card__detail">Installed with dotnet tool</span>
            </div>
            <div class="home-stat-card">
                <span class="home-stat-card__value">@(nugetStats?.FormattedDownloads ?? "--")</span>
                <span class="home-stat-card__label">NuGet downloads</span>
                <span class="home-stat-card__detail">on nuget.org</span>
            </div>
            <div class="home-stat-card">
                <span class="home-stat-card__value">100%</span>
                <span class="home-stat-card__label">Open source</span>
                <span class="home-stat-card__detail">MIT licensed, free to use</span>
            </div>
        </section>

        @* ===== FEATURED APPS ===== *@
        <section class="home-section">
            <div class="home-section__header">
                <div>
                    <div class="section-title">Featured apps</div>
                    <div class="section-subtitle">Apps you can download and use today</div>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/apps" EndIcon="@Icons.Material.Filled.ArrowForward">
                    See all apps
                </MudButton>
            </div>
            <div class="featured-repos-grid">
                @if (featuredAtcApps is null)
                {
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="repo-card repo-card-app" style="min-height: 160px;">
                            <MudSkeleton Width="60%" Height="24px" Class="mb-3" />
                            <MudSkeleton Width="90%" Height="16px" />
                        </div>
                    }
                }
                else
                {
                    @foreach (var card in featuredAtcApps)
                    {
                        <a href="@($"/apps/{card.Name}")" class="repo-card repo-card-app" style="text-decoration: none;">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Apps" Class="app-icon" />
                                <div class="repo-card-name" style="margin-bottom: 0;">@card.DisplayName</div>
                            </div>
                            <div class="repo-card-description">@(card.Pitch ?? "A ready-to-run app.")</div>
                            <div class="repo-card-meta">
                                @if (ShipsFormatter.ForAtcApp(card.DownloadCount) is { } ships)
                                {
                                    <RepositoryFactChip Label="Ships" Values="@([ships])" />
                                }
                                @if (card.Version is not null)
                                {
                                    <RepositoryFactChip Label="Latest" Values="@([card.Version])" />
                                }
                                @if (card.UpdatedAt.HasValue)
                                {
                                    <RepositoryFactChip Label="Updated" Values="@([DisplayFormatHelper.FormatRelativeTime(card.UpdatedAt)])" />
                                }
                            </div>
                        </a>
                    }
                }
            </div>
        </section>

        @* ===== FEATURED LIBRARIES ===== *@
        <section class="home-section">
            <div class="home-section__header">
                <div>
                    <div class="section-title">Featured libraries</div>
                    <div class="section-subtitle">The most used libraries and CLI tools in the ATC-NET ecosystem</div>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/libraries" EndIcon="@Icons.Material.Filled.ArrowForward">
                    See all libraries
                </MudButton>
            </div>
            <div class="featured-repos-grid">
                @if (featuredRepositories is null)
                {
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="repo-card repo-card-core" style="min-height: 160px;">
                            <MudSkeleton Width="60%" Height="24px" Class="mb-3" />
                            <MudSkeleton Width="90%" Height="16px" />
                        </div>
                    }
                }
                else
                {
                    @foreach (var repo in featuredRepositories)
                    {
                        <a href="@($"/libraries/{repo.Name}")" class="repo-card @RepositoryCategoryHelper.GetCardCssClass(repo.Name)" style="text-decoration: none;">
                            <div class="d-flex align-center gap-2 mb-2">
                                <img src="@ImageHelper.GetProgramIconPathForLanguage(repo.Language ?? string.Empty)" width="20" height="20" alt="" />
                                <div class="repo-card-name" style="margin-bottom: 0;">@repo.Name</div>
                            </div>
                            <div class="repo-card-description">@(repo.Description ?? "A .NET library")</div>
                            <div class="repo-card-meta">
                                @if (repo.Ships is not null)
                                {
                                    <RepositoryFactChip Label="Ships" Values="@([repo.Ships])" />
                                }
                                @if (repo.Downloads > 0)
                                {
                                    <RepositoryFactChip Label="Downloads" Values="@([DisplayFormatHelper.FormatDownloads(repo.Downloads)])" />
                                }
                                @if (repo.UpdatedAt.HasValue)
                                {
                                    <RepositoryFactChip Label="Updated" Values="@([DisplayFormatHelper.FormatRelativeTime(repo.UpdatedAt)])" />
                                }
                            </div>
                        </a>
                    }
                }
            </div>
        </section>

        @* ===== WHY ATC-NET ===== *@
        <section class="home-why" aria-label="Why ATC-NET">
            <div>
                <b>Battle-tested</b>
                <p>Built from years of real-world project experience across customers and domains.</p>
            </div>
            <div>
                <b>Open source</b>
                <p>MIT licensed. Fork it, use it, contribute to it.</p>
            </div>
            <div>
                <b>Apps and libraries</b>
                <p>Ready-to-run apps for everyone, built on the libraries we share with developers.</p>
            </div>
            <div>
                <b>Community driven</b>
                <p>Started by two colleagues sharing code, now a growing community on GitHub.</p>
            </div>
        </section>
    </MudContainer>
</MudMainContent>